[Unit]
Description=VasakOS notification daemon (freedesktop Notifications + history)
# Owns org.freedesktop.Notifications and shows banners, so it belongs to the
# graphical session (started by uwsm).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vasak-flare-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
