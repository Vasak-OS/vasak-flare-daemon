[Unit]
Description=VasakOS notification daemon (freedesktop Notifications + history)
# Owns org.freedesktop.Notifications and shows banners, so it belongs to the
# graphical session (started by uwsm).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vasak-flare-daemon
Restart=on-failure
RestartSec=3

# Por acá pasa **todo** lo que cualquier programa quiera decirte, y queda
# guardado en el historial: mensajes, códigos de verificación, avisos del
# correo. Es un blanco atractivo y hasta acá corría sin ninguna restricción.
#
# Sin red: las notificaciones llegan por D-Bus, que es un socket local, y el
# historial se guarda en un archivo. Nada de esto necesita salir a internet, así
# que no puede.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

NoNewPrivileges=yes
# El historial nace privado: son tus notificaciones, no las de todos los
# usuarios de la máquina.
UMask=0077
CapabilityBoundingSet=
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=full

# De todo /dev ve una sola cosa: la placa de video, para dibujar los globos. La
# cámara, el micrófono y los discos dejan de existir para él. Es un /dev privado
# con un montaje adentro y no `DeviceAllow`, porque ese filtro no se aplica en
# unidades de usuario —comprobado— y habría quedado de adorno.
PrivateDevices=yes
BindPaths=-/dev/dri

# Faltan dos de la lista larga, y es a propósito. `MemoryDenyWriteExecute` mata a
# WebKit, que compila el JavaScript de la interfaz en memoria. Y
# `RestrictNamespaces` le saca a WebKit el aislamiento **suyo**, que es una capa
# más, no una menos.

[Install]
WantedBy=graphical-session.target
